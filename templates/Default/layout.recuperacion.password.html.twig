<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8"/>
    <meta content='width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no' name='viewport'>
    <title>{% block title %}Recuperaci&oacute;n de Contraseña{% endblock %}</title>
    <link rel="shortcut icon" type="image/x-icon" href="{{ asset('img/luissolergym-logo-login.png') }}"/>

    {% block stylesheets %}
        <link rel="stylesheet" href=" {{ asset('css/styles.css') }} "/>
        <link rel="stylesheet" href=" {{ asset('css/app.css') }} "/>
        <style>
            html, body {
                height: 100%;
                margin: 0;
            }
            body.signin-body {
                min-height: 100vh;
                background:
                    linear-gradient(135deg, rgba(17, 24, 39, 0.78) 0%, rgba(55, 65, 81, 0.55) 60%, rgba(17, 24, 39, 0.85) 100%),
                    url('{{ asset('img/fondo-login.png') }}') center center / cover no-repeat fixed;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
            }
            body.signin-body::before {
                content: "";
                position: fixed;
                inset: 0;
                background: radial-gradient(ellipse at center, transparent 0%, rgba(0, 0, 0, 0.35) 100%);
                pointer-events: none;
                z-index: 0;
            }
            body.signin-body .login-box {
                position: relative;
                z-index: 1;
                margin-top: 0;
                width: 100%;
                max-width: 380px;
                padding: 40px 35px 30px;
                background: rgba(255, 255, 255, 0.96);
                border: 1px solid rgba(255, 255, 255, 0.6);
                border-radius: 16px;
                box-shadow: 0 25px 60px -15px rgba(0, 0, 0, 0.55), 0 0 0 1px rgba(255, 255, 255, 0.08);
                backdrop-filter: blur(18px);
                -webkit-backdrop-filter: blur(18px);
            }
            body.signin-body .login-logo {
                text-align: center;
                margin-bottom: 25px;
            }
            body.signin-body .login-logo img {
                max-width: 180px;
                height: auto;
            }
            body.signin-body .login-box-body {
                background: transparent;
                padding: 0;
                box-shadow: none;
                border: 0;
            }
            body.signin-body .form-group {
                margin-bottom: 18px;
            }
            body.signin-body .form-control {
                height: 46px;
                border-radius: 10px;
                border: 1px solid #e5e7eb;
                background: #f9fafb;
                box-shadow: none;
                transition: border-color .2s ease, background .2s ease, box-shadow .2s ease;
                padding-left: 14px;
                padding-right: 40px;
            }
            body.signin-body .form-control:focus {
                border-color: #374151;
                background: #fff;
                box-shadow: 0 0 0 3px rgba(55, 65, 81, 0.12);
                outline: 0;
            }
            body.signin-body .form-control-feedback {
                line-height: 46px;
                color: #9ca3af;
            }
            body.signin-body .btn-primary,
            body.signin-body .btn-primary.btn-flat {
                background-color: #111827;
                border-color: #111827;
                border-radius: 10px;
                padding: 10px 22px;
                font-weight: 600;
                letter-spacing: .3px;
                transition: background-color .2s ease, transform .1s ease;
            }
            body.signin-body .btn-primary:hover,
            body.signin-body .btn-primary.btn-flat:hover {
                background-color: #374151;
                border-color: #374151;
            }
            body.signin-body .btn-primary:active,
            body.signin-body .btn-primary.btn-flat:active {
                transform: translateY(1px);
            }
            body.signin-body .alert-warning.bg-primary-dark {
                border-radius: 10px;
                border: 0;
                color: #fff;
                font-size: 13px;
            }
            body.signin-body .box-header {
                font-weight: 600;
                color: #111827;
                padding: 0 0 14px;
                border: 0;
            }
            @media (max-width: 480px) {
                body.signin-body .login-box {
                    margin: 16px;
                    padding: 30px 22px 22px;
                }
            }
        </style>
    {% endblock %}
</head>
<body class="signin-body">
<div>
    {% trans_default_domain 'NucleosUserBundle' %}

    {% block nucleos_user_content %}
        <div class="login-logo">
            <img src="{{ asset('img/luissolergym-logo-login.png') }}" width="200">
        </div>
    {% endblock nucleos_user_content %}

    <script src="{{ asset('js/jquery.js') }}"></script>
    <script src="{{ asset('js/javascript.js') }}"></script>
</div>
{% block javascripts %}{% endblock %}
</body>
</html>
