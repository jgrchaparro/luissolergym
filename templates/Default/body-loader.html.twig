{% set outerSpinnerColor = outerSpinnerColor|default('#ff585f') %}
<style>
    #body-loader {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.4);
        z-index: 9999;
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(2px);
    }

    .spinner {
        position: relative;
        width: 90px;
        height: 90px;
    }

    .spinner svg {
        width: 100%;
        height: 100%;
        overflow: visible;
    }

    .outer-arc {
        animation: spinOuter 1.4s ease-in-out infinite;
    }

    .inner-arc {
        animation: spinInner 0.7s ease-in-out infinite;
    }

    @keyframes spinOuter {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }

    @keyframes spinInner {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
<div id="body-loader">
    <div class="spinner">
        <svg viewBox="0 0 100 100">
            <!-- Fondo circular -->
            <circle cx="50" cy="50" r="48" fill="rgba(255,255,255,0.2)"/>

            <defs>
                <!-- Máscaras para el efecto de grosor variable -->
                <mask id="outerMask">
                    <path
                        d="M 50 4 A 46 46 0 1 1 4 50"
                        fill="none"
                        stroke="url(#whiteFade1)"
                        stroke-width="20"
                        stroke-linecap="round"
                    />
                </mask>
                <mask id="innerMask">
                    <path
                        d="M 50 8 A 42 42 0 1 1 8 50"
                        fill="none"
                        stroke="url(#whiteFade1)"
                        stroke-width="20"
                        stroke-linecap="round"
                    />
                </mask>

                <linearGradient id="whiteFade1" gradientUnits="userSpaceOnUse" x1="8" y1="50" x2="90" y2="50">
                    <stop offset="0%" stop-color="white" stop-opacity="0"/>
                    <stop offset="15%" stop-color="white" stop-opacity="0.3"/>
                    <stop offset="100%" stop-color="white" stop-opacity="1"/>
                </linearGradient>
            </defs>

            <!-- Grupo exterior con animación -->
            <g class="outer-arc" style="transform-origin: 50px 50px;">
                <path
                    d="M 50 4 A 46 46 0 1 1 4 50"
                    fill="none"
                    stroke="{{ outerSpinnerColor }}"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    mask="url(#outerMask)"
                />
            </g>

            <!-- Grupo interior con animación -->
            <g class="inner-arc" style="transform-origin: 50px 50px;">
                <path
                    d="M 50 8 A 42 42 0 1 1 8 50"
                    fill="none"
                    stroke="#2ab5b5"
                    stroke-width="3.5"
                    stroke-linecap="round"
                    mask="url(#innerMask)"
                />
            </g>
        </svg>
    </div>
</div>
