{% extends 'base.html.twig' %}

{% block menu_principal %}
    {{ include('Menu/menuprincipal.html.twig') }}
{% endblock %}

{% block title %}Tasas{% endblock %}

{% block body %}
    <div ng-app="ngMainApp" ng-controller="ngTasasController as $ctrl">

        {# ===== HEADER ===== #}
        <div class="box">
            <div class="box-header with-border">
                <i class="fa fa-exchange fa-fw"></i> Tasas
                <div class="box-tools">
                    <button class="btn btn-default btn-sm" ng-click="$ctrl.abrirModalAgregar()">
                        <i class="fa fa-plus"></i>&nbsp; Agregar Tasa
                    </button>
                </div>
            </div>
        </div>

        {# ===== FILTROS + TABLA ===== #}
        <div class="row">
            <div class="col-md-3">
                <div class="box">
                    <div class="box-header with-border">
                        <i class="fa fa-filter fa-fw"></i> Filtros
                    </div>
                    <div class="box-body">
                        <div class="form-group">
                            <label>Buscar por valor</label>
                            <div class="input-group">
                                <input type="text" class="form-control" ng-model="$ctrl.busqueda"
                                       ng-keypress="$event.keyCode === 13 && $ctrl.buscar()"
                                       placeholder="Ingrese búsqueda...">
                                <span class="input-group-btn">
                                    <button class="btn btn-primary btn-flat" ng-click="$ctrl.buscar()">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                        </div>
                        <button class="btn btn-default btn-flat btn-block" ng-click="$ctrl.limpiarFiltro()">
                            <i class="fa fa-eraser"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="box">
                    <div class="box-body">
                        <div class="text-center" ng-show="$ctrl.loading">
                            <i class="fa fa-spinner fa-spin fa-2x"></i>
                        </div>
                        <table class="table table-hover" ng-hide="$ctrl.loading">
                            <thead>
                            <tr>
                                <th>USD / VEF</th>
                                <th>USD / COP</th>
                                <th>Tasa (COP/VEF)</th>
                                <th>Fecha Creación</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr ng-repeat="tasa in $ctrl.tasas">
                                <td>{% verbatim %}{{ tasa.usd_vef | number:4 }}{% endverbatim %}</td>
                                <td>{% verbatim %}{{ tasa.usd_cop | number:4 }}{% endverbatim %}</td>
                                <td>{% verbatim %}{{ tasa.tasa | number:6 }}{% endverbatim %}</td>
                                <td ng-bind="tasa.fechaCreacion"></td>
                            </tr>
                            </tbody>
                        </table>
                        <div class="text-center" ng-hide="$ctrl.loading || $ctrl.tasas.length > 0">
                            <p class="text-muted">No se encontraron tasas.</p>
                        </div>
                    </div>
                    <div class="box-footer clearfix" ng-hide="$ctrl.loading">
                        <div class="pull-left" style="line-height: 34px;">
                            Mostrando {% verbatim %}{{ $ctrl.tasas.length }}{% endverbatim %} de {% verbatim %}{{ $ctrl.total }}{% endverbatim %} registros
                        </div>
                        <ul class="pagination pagination-sm no-margin pull-right">
                            <li ng-class="{disabled: $ctrl.paginaActual <= 1}">
                                <a href ng-click="$ctrl.irPagina($ctrl.paginaActual - 1)"><i class="fa fa-chevron-left"></i></a>
                            </li>
                            <li ng-repeat="p in $ctrl.paginas" ng-class="{active: p === $ctrl.paginaActual}">
                                <a href ng-click="$ctrl.irPagina(p)" ng-bind="p"></a>
                            </li>
                            <li ng-class="{disabled: $ctrl.paginaActual >= $ctrl.totalPaginas}">
                                <a href ng-click="$ctrl.irPagina($ctrl.paginaActual + 1)"><i class="fa fa-chevron-right"></i></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# ===== MODAL AGREGAR ===== #}
        <div class="modal" id="modalTasa" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal">&times;</button>
                        <h4 class="box-title">
                            <i class="fa fa-exchange fa-fw"></i> Nueva Tasa
                        </h4>
                    </div>
                    <form name="tasaForm" ng-submit="$ctrl.guardar()">
                        <div class="modal-body">
                            <div class="alert alert-danger" ng-show="$ctrl.error">
                                <i class="fa fa-ban"></i> {% verbatim %}{{ $ctrl.error }}{% endverbatim %}
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>USD / VEF</label>
                                        <input type="number" step="any" min="0" class="form-control"
                                               ng-model="$ctrl.formData.usd_vef"
                                               ng-change="$ctrl.recalcular()" required>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>USD / COP</label>
                                        <input type="number" step="any" min="0" class="form-control"
                                               ng-model="$ctrl.formData.usd_cop"
                                               ng-change="$ctrl.recalcular()" required>
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-12">
                                    <div class="form-group">
                                        <label>Tasa calculada (COP / VEF)</label>
                                        <input type="text" class="form-control"
                                               ng-value="$ctrl.tasaCalculada | number:6"
                                               readonly>
                                        <span class="help-block">
                                            Se calcula automáticamente como USD/COP ÷ USD/VEF.
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-flat btn-default pull-left" data-dismiss="modal">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-flat btn-primary">
                                <i class="fa fa-save"></i> Registrar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/appInit.js') }}"></script>
    <script src="{{ asset('js/angular/tasas-controller.js') }}"></script>
{% endblock %}
