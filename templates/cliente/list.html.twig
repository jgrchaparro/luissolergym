{% extends 'base.html.twig' %}

{% block menu_principal %}
    {{ include('Menu/menuprincipal.html.twig') }}
{% endblock %}

{% block title %}Miembros{% endblock %}

{% block body %}
    <div ng-app="ngMainApp" ng-controller="ngClienteController as $ctrl">

        {# ===== HEADER ===== #}
        <div class="box">
            <div class="box-header with-border">
                <i class="fa fa-users fa-fw"></i> Miembros
                <div class="box-tools">
                    <button class="btn btn-default btn-sm" ng-click="$ctrl.abrirModalAgregar()">
                        <i class="fa fa-plus"></i>&nbsp; Agregar
                    </button>
                </div>
            </div>
        </div>

        {# ===== FILTROS + TABLA ===== #}
        <div class="row">
            <div class="col-md-3">
                <div class="box">
                    <div class="box-header with-border">
                        <i class="fa fa-filter fa-fw"></i> Filtros
                    </div>
                    <div class="box-body">
                        <div class="form-group">
                            <label>Buscar por cédula o nombre</label>
                            <div class="input-group">
                                <input type="text" class="form-control" ng-model="$ctrl.busqueda"
                                       ng-keypress="$event.keyCode === 13 && $ctrl.buscar()"
                                       placeholder="Ingrese búsqueda...">
                                <span class="input-group-btn">
                                    <button class="btn btn-primary btn-flat" ng-click="$ctrl.buscar()">
                                        <i class="fa fa-search"></i>
                                    </button>
                                </span>
                            </div>
                        </div>
                        <div class="form-group">
                            <label>Estado</label>
                            <select class="form-control" ng-model="$ctrl.estado" ng-change="$ctrl.buscar()">
                                <option value="">Todos</option>
                                <option value="vencido">Vencidos</option>
                                <option value="aldia">Al d&iacute;a</option>
                            </select>
                        </div>
                        <button class="btn btn-default btn-flat btn-block" ng-click="$ctrl.limpiarFiltro()">
                            <i class="fa fa-eraser"></i> Limpiar
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-9">
                <div class="box">
                    <div class="box-body">
                        <div class="text-center" ng-show="$ctrl.loading">
                            <i class="fa fa-spinner fa-spin fa-2x"></i>
                        </div>
                        <div class="table-responsive" ng-hide="$ctrl.loading" style="overflow-x: auto;">
                        <table class="table table-hover">
                            <thead>
                            <tr>
                                <th>Cédula</th>
                                <th>Nombres</th>
                                <th>Apellidos</th>
                                <th>Email</th>
                                <th>Teléfono</th>
                                <th>Tipo Mensualidad</th>
                                <th>Vence</th>
                                <th>Fecha Creación</th>
                                <th class="text-right"><i class="fa fa-cogs fa-fw"></i> Acciones</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr ng-repeat="cliente in $ctrl.clientes">
                                <td ng-bind="cliente.cedula"></td>
                                <td ng-bind="cliente.nombres"></td>
                                <td ng-bind="cliente.apellidos"></td>
                                <td ng-bind="cliente.email"></td>
                                <td ng-bind="cliente.telefono"></td>
                                <td><span class="label label-info" ng-if="cliente.tipoMensualidadCodigo" ng-bind="cliente.tipoMensualidadCodigo"></span></td>
                                <td>
                                    <span ng-if="cliente.fechaVencimiento" ng-bind="cliente.fechaVencimiento"></span>
                                    <span ng-if="!cliente.fechaVencimiento" class="text-muted">&mdash;</span>
                                    <span class="label label-default" ng-if="cliente.sinPagos">Sin pagos</span>
                                    <span class="label label-danger" ng-if="cliente.vencido && !cliente.sinPagos">Vencido</span>
                                    <span class="label label-success" ng-if="!cliente.vencido">Al d&iacute;a</span>
                                </td>
                                <td ng-bind="cliente.fechaCreacion"></td>
                                <td class="text-right">
                                    <button class="btn btn-default btn-sm" ng-click="$ctrl.abrirModalEditar(cliente.id)">
                                        <i class="fa fa-pencil fa-fw"></i>
                                    </button>
                                    <button class="btn btn-danger btn-sm" ng-click="$ctrl.confirmarEliminar(cliente)">
                                        <i class="fa fa-trash fa-fw"></i>
                                    </button>
                                </td>
                            </tr>
                            </tbody>
                        </table>
                        </div>
                        <div class="text-center" ng-hide="$ctrl.loading || $ctrl.clientes.length > 0">
                            <p class="text-muted">No se encontraron clientes.</p>
                        </div>
                    </div>
                    <div class="box-footer clearfix" ng-hide="$ctrl.loading">
                        <div class="pull-left" style="line-height: 34px;">
                            Mostrando {% verbatim %}{{ $ctrl.clientes.length }}{% endverbatim %} de {% verbatim %}{{ $ctrl.total }}{% endverbatim %} registros
                        </div>
                        <ul class="pagination pagination-sm no-margin pull-right">
                            <li ng-class="{disabled: $ctrl.paginaActual <= 1}">
                                <a href ng-click="$ctrl.irPagina($ctrl.paginaActual - 1)"><i class="fa fa-chevron-left"></i></a>
                            </li>
                            <li ng-repeat="p in $ctrl.paginas" ng-class="{active: p === $ctrl.paginaActual}">
                                <a href ng-click="$ctrl.irPagina(p)" ng-bind="p"></a>
                            </li>
                            <li ng-class="{disabled: $ctrl.paginaActual >= $ctrl.totalPaginas}">
                                <a href ng-click="$ctrl.irPagina($ctrl.paginaActual + 1)"><i class="fa fa-chevron-right"></i></a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>

        {# ===== MODAL AGREGAR / EDITAR ===== #}
        <div class="modal" id="modalCliente" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal" ng-disabled="$ctrl.guardando">&times;</button>
                        <h4 class="box-title">
                            <i class="fa fa-user fa-fw"></i>
                            <span ng-hide="$ctrl.isEdit">Nuevo Cliente</span>
                            <span ng-show="$ctrl.isEdit">Editar Cliente</span>
                        </h4>
                    </div>
                    <form name="clienteForm" ng-submit="$ctrl.guardar()">
                        <div class="modal-body">
                            <div class="alert alert-danger" ng-show="$ctrl.error">
                                <i class="fa fa-ban"></i> {% verbatim %}{{ $ctrl.error }}{% endverbatim %}
                            </div>
                            <div class="form-group" ng-class="{'has-error': clienteForm.cedula.$touched && clienteForm.cedula.$invalid}">
                                <label>Cédula</label>
                                <div class="input-group">
                                    <span class="input-group-addon" style="padding: 0; border: none;">
                                        <select class="form-control" ng-model="$ctrl.formData.nacionalidad"
                                                ng-options="n for n in $ctrl.nacionalidades"
                                                style="border-radius: 4px 0 0 4px; min-width: 60px;" required
                                                ng-disabled="$ctrl.guardando">
                                        </select>
                                    </span>
                                    <input type="text" name="cedula" class="form-control"
                                           ng-model="$ctrl.formData.cedulaNumero"
                                           solo-numeros
                                           ng-pattern="/^\d{6,9}$/"
                                           ng-minlength="6" ng-maxlength="9"
                                           maxlength="9"
                                           placeholder="Ej: 15999636"
                                           required ng-disabled="$ctrl.guardando">
                                </div>
                                <span class="help-block" ng-show="clienteForm.cedula.$touched && clienteForm.cedula.$error.required">
                                    La cédula es obligatoria.
                                </span>
                                <span class="help-block" ng-show="clienteForm.cedula.$touched && clienteForm.cedula.$error.pattern">
                                    Solo números, mínimo 6 y máximo 9 dígitos.
                                </span>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Nombres</label>
                                        <input type="text" class="form-control" ng-model="$ctrl.formData.nombres" required
                                               ng-disabled="$ctrl.guardando">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Apellidos</label>
                                        <input type="text" class="form-control" ng-model="$ctrl.formData.apellidos" required
                                               ng-disabled="$ctrl.guardando">
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Email</label>
                                        <input type="email" class="form-control" ng-model="$ctrl.formData.email" required
                                               ng-disabled="$ctrl.guardando">
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group">
                                        <label>Teléfono</label>
                                        <input type="text" class="form-control" ng-model="$ctrl.formData.telefono" required
                                               ng-disabled="$ctrl.guardando">
                                    </div>
                                </div>
                            </div>
                            <div class="form-group">
                                <label>Tipo de Mensualidad</label>
                                <mensualidad-picker items="$ctrl.tiposMensualidad"
                                                    model="$ctrl.formData.tipo_mensualidad_id"
                                                    disabled="$ctrl.guardando"></mensualidad-picker>
                            </div>
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-flat btn-default pull-left" data-dismiss="modal"
                                    ng-disabled="$ctrl.guardando">
                                Cancelar
                            </button>
                            <button type="submit" class="btn btn-flat btn-primary" ng-disabled="$ctrl.guardando">
                                <span class="btn-spinner" ng-show="$ctrl.guardando"></span>
                                <i class="fa fa-save" ng-hide="$ctrl.guardando"></i>
                                <span ng-show="$ctrl.guardando">Guardando...</span>
                                <span ng-hide="$ctrl.guardando || $ctrl.isEdit">Registrar</span>
                                <span ng-show="!$ctrl.guardando && $ctrl.isEdit">Actualizar</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        {# ===== MODAL ELIMINAR ===== #}
        <div class="modal" id="modalEliminar" role="dialog">
            <div class="modal-dialog" role="document">
                <div class="modal-content">
                    <div class="modal-header">
                        <button class="close" data-dismiss="modal">&times;</button>
                        <h4 class="box-title"><i class="fa fa-exclamation-triangle"></i> Confirmación</h4>
                    </div>
                    <div class="modal-body">
                        <p style="font-size: 16px;">¿Está seguro de eliminar este cliente?</p>
                        <table class="table table-bordered">
                            <tr>
                                <th style="width: 120px;">Cédula</th>
                                <td ng-bind="$ctrl.clienteEliminar.cedula"></td>
                            </tr>
                            <tr>
                                <th>Nombre</th>
                                <td>{% verbatim %}{{ $ctrl.clienteEliminar.nombres }} {{ $ctrl.clienteEliminar.apellidos }}{% endverbatim %}</td>
                            </tr>
                        </table>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-flat btn-default pull-left" data-dismiss="modal">
                            Cancelar
                        </button>
                        <button type="button" class="btn btn-flat btn-danger" ng-click="$ctrl.eliminar()">
                            <i class="fa fa-trash"></i> Eliminar
                        </button>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('css/toast.css') }}"/>
{% endblock %}

{% block javascripts %}
    <script src="{{ asset('js/toast.js') }}"></script>
    <script src="{{ asset('js/appInit.js') }}"></script>
    <script src="{{ asset('js/angular/shared-directives.js') }}"></script>
    <script src="{{ asset('js/angular/cliente-controller.js') }}"></script>
{% endblock %}
