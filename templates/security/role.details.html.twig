{% extends 'base.html.twig' %}

{% block menu_principal %}
    {{ include('Menu/menuprincipal.html.twig') }}
{% endblock %}

{% block title %}
    Permiso
{% endblock %}

{% block body %}
    <div class="box">
        <div class="box-header">
            Detalles del Permiso
            <div class="box-tools">
                <a class="btn btn-default btn-sm" href="{{ path('role_list') }}">
                    <i class="fa fa-arrow-left"></i>&nbsp;
                    Listado de Permisos
                </a>
            </div>
        </div>
    </div>
    <div class="row">
        <div class="col-md-4">
            <div class="box">
                <div class="box-header with-border">
                    Permiso
                    <div class="box-tools">
                        {% if is_granted('ROLE_DELETE_ROLE') %}
                            <button id="btnEliminar" class="btn btn-sm btn-danger" type="button">Eliminar</button>
                        {% endif %}
                        {% if is_granted('ROLE_EDIT_ROLE') %}
                            <a href="{{ path('role_edit', {'id':role.id}) }}" class="btn btn-sm btn-default">
                                <i class="fa fa-edit"></i>
                                Modificar
                            </a>
                        {% endif %}
                    </div>
                </div>
                <div class="box-body no-padding">
                    <table class="table">
                        <tr class="tr">
                            <th>Nombre</th>
                            <td>{{ role.role }}</td>
                        </tr>
                        <tr class="tr">
                            <th>Descripci&oacute;n</th>
                            <td>{{ role.descripcion }}</td>
                        </tr>
                    </table>
                </div>
            </div>
        </div>
        <div class="col-md-8"></div>
    </div>
    {% include 'security/modal.role.eliminar.html.twig' %}
{% endblock %}
{% block javascripts %}
    <script>
        let $btnDeleteRole =  $('#eliminarRole');
        let $btnCancelRole = $('#btnCancelRole')

        $('#btnEliminar').on('click', function () {
            $('#modalRoleEliminar').modal('show')
        });
        $btnDeleteRole.on('click', function (){
            $btnDeleteRole.attr('disabled', true)
            $btnCancelRole.attr('disabled', true)
        });
    </script>
{% endblock javascripts %}