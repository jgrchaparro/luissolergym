{% extends 'Default/layout.recuperacion.password.html.twig' %}
{% form_theme form 'bootstrap_3_layout.html.twig' %}

{% block nucleos_user_content %}
    <div class="login-box">
        {{ parent() }}
        <!-- /.login-logo -->
        <div class="login-box-body">
            {{ form_start(form) }}
            <div class="form-group has-feedback">
                {{ form_widget(form.plainPassword.first, {'attr' : {'maxlength': 30, 'class': 'form-control', 'placeholder': 'Nueva contraseña' }} ) }}
                <span class="fa fa-eye-slash form-control-feedback icon-form" id="first-icon"></span>
            </div>
            <div class="form-group has-feedback">
                {{ form_widget(form.plainPassword.second, {'attr': {'class': 'form-control', 'placeholder': 'Confirmar contraseña'}}) }}
                <span class="fa fa-eye-slash form-control-feedback icon-form" id="second-icon"></span>
            </div>
            <div class="has-error">{{ form_errors(form.plainPassword.first) }}</div>

            <p class="text-center">
                <button type="submit" class="btn btn-primary btn-flat" style="margin-top: 10px">
                    Restaurar Contraseña
                </button>
            </p>
            {{ form_end(form) }}
        </div>
    </div>
{% endblock nucleos_user_content %}
{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            let inputFirstPassword = $('#user_recovery_password_plainPassword_first');
            let inputSecondPassword = $('#user_recovery_password_plainPassword_second');
            let firstIcon = $('#first-icon');
            let secondIcon = $('#second-icon');

            inputFirstPassword.focus();

            function passwordVisibility(input, icon) {
                const isPassword = input.attr('type') === 'password';
                input.attr('type', isPassword ? 'text' : 'password');
                icon.toggleClass('fa-eye', isPassword);
                icon.toggleClass('fa-eye-slash', !isPassword);
                input.focus()[0].setSelectionRange(input.val().length, input.val().length);
            }

            firstIcon.on('click', function () {
                passwordVisibility(inputFirstPassword, firstIcon);
            });

            secondIcon.on('click', function () {
                passwordVisibility(inputSecondPassword, secondIcon);
            });
        });
    </script>
{% endblock %}
