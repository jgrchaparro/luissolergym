{% extends 'Default/layout.recuperacion.password.html.twig' %}

{% block nucleos_user_content %}
    <div class="login-box">
        {{ parent() }}
        <!-- /.login-logo -->
        <div class="login-box-body">
            <form action="{{ path('user_recuperacion_validacion_usuario') }}" method="post">
                <input type="hidden" name="_csrf_token" value=""/>

                <div class="form-group has-feedback">
                    <input type="text" class="form-control" placeholder="Usuario" autofocus id="username"
                           name="_username" required="required"/>
                    <span class="glyphicon glyphicon-user form-control-feedback"></span>
                </div>

                <div style="padding: 10px 0;">
                    <a href="{{ path('nucleos_user_security_login') }}" class="btn btn-primary  btn-flat">
                        Login
                    </a>
                    <button type="submit" class="btn btn-primary  btn-flat pull-right">Enviar</button>
                </div>
            </form>
            {% for type, flashes in app.session.flashbag.all %}
                {% for flash in flashes %}
                    <div class="alert alert-warning bg-movilnet" style="margin-top: 10px">
                        {{ flash }}
                    </div>
                {% endfor %}
            {% endfor %}
        </div>
    </div>
{% endblock nucleos_user_content %}