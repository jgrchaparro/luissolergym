{% extends 'base.html.twig' %}

{% block menu_principal %}
    {{ include('Menu/menuprincipal.html.twig') }}
{% endblock %}

{% block title %}
    Movilnet::Rol
{% endblock %}

{% block body %}
    <style>
        .roles-container-group {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr 1fr !important;
            gap: 10px;
        }
        .role-item {
            display: flex;
            align-items: center;
            transition: background-color 0.3s ease;
            height: 25px;
        }

        .role-label {
            position: relative;
            font-size: 14px;
        }

        .role-tooltip {
            cursor: pointer;
        }
        .input-check-roles-group {
            transform: scale(1.3) !important;
            margin-le
            ft: 4px !important;
        }
        .role-item:hover {
            background-color: #eae8e8;
        }

        .roles-container {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr !important;
            gap: 10px;
        }
        .role-checkbox {
            margin-right: 10px;
        }
    </style>

    <div class="box">
        <div class="box-header with-border">
            ROLE {{ group.name | upper }}
        </div>
        <div class="box-body">
            <a class="btn btn-default btn-sm" href="{{ path('group_list') }}">
                <i class="fa fa-arrow-left"></i>&nbsp;
                Listado de Roles
            </a>
            {% if is_granted('ROLE_GROUP_DELETE') %}
                <button id="btnEliminar" class="btn btn-sm btn-danger" type="button">Eliminar</button>
            {% endif %}
            {% if is_granted('ROLE_GROUP_EDIT') %}
                <a href="{{ path('group_edit', {'id':group.id}) }}" class="btn btn-sm btn-default">
                    <i class="fa fa-edit"></i>
                    Modificar
                </a>
            {% endif %}
        </div>
    </div>
    <div class="row">
        <div class="col-md-12" ng-app="ngMainApp" ng-controller="ngUserGroupController as $ctrl">
            <div class="box">
                <div class="box-header with-border">
                    Permisos
                </div>
                <div class="box-body">
                    <div class="roles-container-group">
                        {% for role in roles %}
                            {% set checked = '' %}
                            {% if group.role(role.role) %}
                                {% set checked = 'checked' %}
                            {% endif %}
                            <div class="role-item">
                                <div class="role-checkbox text-right">
                                    <input class="input-check-roles-group" type="checkbox" style="cursor: pointer;"
                                           id="check[{{ role.id }}]" {{ checked }}
                                           ng-click="$ctrl.checkRole('{{ role.id }}', '{{ group.id }}' )">
                                </div>
                                <div class="role-label">
                                    <label for="check[{{ role.id }}]"
                                           class="role-tooltip"
                                           data-description="{{ role.descripcion }}" style="margin-bottom: 0" title="{{ role.descripcion }}">
                                        {{ role.role }}
                                    </label>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
        {% include 'security/modal.group.eliminar.html.twig' %}
    </div>
{% endblock %}
{% block javascripts %}
    <script src="{{ asset('js/security/app.js') }}"></script>
    <script src="{{ asset('js/security/user-groups.js') }}"></script>

    <script>
        $('#btnEliminar').on('click', function () {
            $('#modalGroupEliminar').modal('show')
        });

        document.querySelectorAll('.role-tooltip').forEach(tooltip => {
            tooltip.addEventListener('mousemove', event => {
                const screenWidth = window.innerWidth;
                const mouseX = event.clientX;

                if (mouseX < screenWidth / 2) {
                    // Si está en la mitad izquierda
                    tooltip.style.setProperty('--dynamic-left', '0'); // Posicionar con left
                    tooltip.style.setProperty('--dynamic-right', 'auto'); // Desactivar right
                } else {
                    // Si está en la mitad derecha
                    tooltip.style.setProperty('--dynamic-left', 'auto'); // Desactivar left
                    tooltip.style.setProperty('--dynamic-right', '0'); // Posicionar con right
                }
            });
        });
    </script>
{% endblock javascripts %}