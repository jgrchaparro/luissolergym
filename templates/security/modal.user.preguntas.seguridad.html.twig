<div class="modal" id="modalPreguntasSeguridad" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        {{ form_start(formAnswer, {'attr':{'id':'formPreguntas'}}) }}
        <div class="modal-content">
            <div class="modal-header">
                <button class="close">×</button>
                <h4 class="box-title">Preguntas de seguridad</h4>
            </div>
            <div class="box-body text-bold">
                {{ form_widget(formAnswer) }}
            </div>
            <div class="modal-footer">
                <div>
                    <button id="btnCancelPreguntaSeguridad" class="btn btn-flat btn-danger pull-left"
                            data-dismiss="modal">
                        Cancelar
                    </button>

                    <button class="btn btn-flat btn-success" id="guardarPreguntas" type="submit">
                        <i class="fa fa-fw fa-save"></i>
                        Guardar
                    </button>
                </div>
            </div>
        </div>
        {{ form_end(formAnswer) }}
    </div>
</div>