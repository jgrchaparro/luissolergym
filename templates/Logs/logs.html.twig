{% extends 'base.html.twig' %}

{% block menu_principal %}
    {{ include('Menu/menuprincipal.html.twig') }}
{% endblock %}

{% block title %}
    Movilnet::Logs
{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-md-3">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">Filtros</h3>
                    <div class="box-tools pull-right">
                        <button type="button" class="btn btn-box-tool" data-widget="collapse"><i
                                    class="fa fa-minus"></i>
                        </button>
                    </div>
                </div>
                <div class="box-body">
                    <input id="username" class="form-control" placeholder="ingrese username"
                           title="ingrese nombre del usuario que desea buscar">

                </div>
                <div class="box-body">
                    <div id="filtros_fecha"
                         style="background: #fff; cursor: pointer; padding: 5px 10px; border: 1px solid #ccc;"
                         ng-model="ctrl.filtros.fecha">
                        <i class="glyphicon glyphicon-calendar fa fa-calendar"></i>&nbsp;
                        <span></span> <b class="caret"></b>
                    </div>
                </div>
                <div class="box-footer">
                    <button type="button" onclick="updateTable()" class="btn btn-primary btn-sm pull-right">
                        <i class="fa fa-fw fa-filter"></i>
                        Filtrar
                    </button>
                </div>
            </div>
        </div>
        <div class="col-md-9">
            <div class="box">
                <div class="box-header with-border">
                    <h3 class="box-title">Historial</h3>
                </div>
                <div class="box-body">
                    <div class="table-responsive">
                        <table id="tableLogs" class="table table-hover table-striped" style="width: 100%">
                            <thead>
                            <th></th>
                            <th>Fecha</th>
                            <th>User</th>
                            <th>Acci&oacute;n</th>
                            </thead>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
{% endblock %}

{% block javascripts %}
    <script>
        var table;
        var startDate;
        var endDate;

        $(document).ready(function () {
            table = $('#tableLogs').DataTable({
                "sDom": "ltipr",
                "deferLoading": 0,
                "processing": true,
                "serverSide": true,
                "ajax": "{{ path('super_logs_listar') }}",
                "columnDefs": [
                    {
                        "visible": false,
                        "targets": [0]
                    },
                    {
                        "orderable": false,
                        "targets": [1, 2, 3]
                    },
                ],
                "oLanguage": {
                    "sProcessing": "Buscando información, por favor espere...",
                    "sInfo": "Un total de _TOTAL_ registros para mostrar (_START_ a _END_)",
                    "sLengthMenu": "Mostrando _MENU_ movimientos",
                    "oPaginate": {
                        "sNext": "Siguiente",
                        "sPrevious": "Anterior"
                    },
                    "sEmptyTable": "No se encontraron movimientos",
                    "sInfoEmpty": "_TOTAL_ movimientos",
                    "sSearch": "Buscar"
                }
            });

            $('#filtros_fecha').daterangepicker(datePickerOptions, cb);
            cb(moment(), moment());

            updateTable();

        });

        function cb(start, end) {
            startDate = start;
            endDate = end;

            $('#filtros_fecha span').html(start.format('MMMM D, YYYY') + ' - ' + end.format('MMMM D, YYYY'));
        }

        function updateTable() {
            table.columns(0).search(startDate.format('YYYY-MM-DD'));
            table.columns(1).search(endDate.format('YYYY-MM-DD'));
            table.columns(2).search($('#username').val());

            table.draw();
        }
    </script>
{% endblock javascripts %}